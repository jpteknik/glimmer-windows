<!-- Ported from App/Theme.swift, plus the shared control styles the views use. Colours come from Theme.cs; views use
     them as DynamicResource so high contrast can replace them (ThemeResources.cs). Styles that refine a Fluent control
     are keyed (never implicit for a Fluent type), so BasedOn always finds the Fluent style and never itself. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:g="clr-namespace:Glimmer.App"
                    xmlns:c="clr-namespace:Glimmer.App.Controls"
                    xmlns:l="clr-namespace:Glimmer.App.Localization"
                    xmlns:core="clr-namespace:Glimmer.Core;assembly=Glimmer.Core"
                    xmlns:v="clr-namespace:Glimmer.App.Views">

  <!-- Colours and brushes (Theme.swift) -->
  <SolidColorBrush x:Key="Glimmer.BackgroundBrush" Color="{x:Static g:Theme.Background}" />
  <SolidColorBrush x:Key="Glimmer.PanelBrush" Color="{x:Static g:Theme.Panel}" />
  <SolidColorBrush x:Key="Glimmer.PanelSurfaceBrush" Color="{x:Static g:Theme.PanelSurface}" />
  <SolidColorBrush x:Key="Glimmer.RaisedBrush" Color="{x:Static g:Theme.Raised}" />
  <SolidColorBrush x:Key="Glimmer.EdgeBrush" Color="{x:Static g:Theme.Edge}" />
  <SolidColorBrush x:Key="Glimmer.InkBrush" Color="{x:Static g:Theme.Ink}" />
  <SolidColorBrush x:Key="Glimmer.InkSoftBrush" Color="{x:Static g:Theme.InkSoft}" />
  <SolidColorBrush x:Key="Glimmer.MutedBrush" Color="{x:Static g:Theme.Muted}" />
  <SolidColorBrush x:Key="Glimmer.TertiaryBrush" Color="{x:Static g:Theme.Tertiary}" />
  <SolidColorBrush x:Key="Glimmer.AccentBrush" Color="{x:Static g:Theme.Accent}" />
  <SolidColorBrush x:Key="Glimmer.AccentFillBrush" Color="{x:Static g:Theme.AccentFill}" />
  <SolidColorBrush x:Key="Glimmer.AccentTint35Brush" Color="{x:Static g:Theme.AccentTint35}" />
  <SolidColorBrush x:Key="Glimmer.AccentTint28Brush" Color="{x:Static g:Theme.AccentTint28}" />
  <SolidColorBrush x:Key="Glimmer.AccentTint20Brush" Color="{x:Static g:Theme.AccentTint20}" />
  <SolidColorBrush x:Key="Glimmer.AccentTint15Brush" Color="{x:Static g:Theme.AccentTint15}" />
  <SolidColorBrush x:Key="Glimmer.AccentTint8Brush" Color="{x:Static g:Theme.AccentTint8}" />
  <SolidColorBrush x:Key="Glimmer.FieldEdgeBrush" Color="{x:Static g:Theme.FieldEdge}" />
  <SolidColorBrush x:Key="Glimmer.ScrimBrush" Color="{x:Static g:Theme.Scrim}" />
  <SolidColorBrush x:Key="Glimmer.OnAccentBrush" Color="White" />
  <SolidColorBrush x:Key="Glimmer.Status.ErrorBrush" Color="{x:Static g:Theme.StatusError}" />
  <SolidColorBrush x:Key="Glimmer.Status.WarningBrush" Color="{x:Static g:Theme.StatusWarning}" />
  <SolidColorBrush x:Key="Glimmer.Status.NoticeBrush" Color="{x:Static g:Theme.StatusNotice}" />
  <SolidColorBrush x:Key="Glimmer.Status.SuccessBrush" Color="{x:Static g:Theme.StatusSuccess}" />

  <!-- Type sizes (SwiftUI text styles on the Mac, in DIPs) -->
  <FontFamily x:Key="Glimmer.Font">Segoe UI Variable Text, Segoe UI</FontFamily>
  <FontFamily x:Key="Glimmer.MonoFont">Cascadia Mono, Consolas</FontFamily>
  <sys:Double x:Key="Glimmer.Size.Body">13</sys:Double>
  <sys:Double x:Key="Glimmer.Size.Callout">12.5</sys:Double>
  <sys:Double x:Key="Glimmer.Size.Caption">11</sys:Double>
  <sys:Double x:Key="Glimmer.Size.Caption2">10</sys:Double>
  <sys:Double x:Key="Glimmer.Size.Headline">13</sys:Double>
  <sys:Double x:Key="Glimmer.Size.Title3">16</sys:Double>
  <sys:Double x:Key="Glimmer.Size.LargeTitle">26</sys:Double>

  <!-- Converters -->
  <c:BoolToVisibility x:Key="BoolToVisibility" />
  <c:NullToVisibility x:Key="NullToVisibility" />
  <l:LocConverter x:Key="Loc" />
  <l:LocFormatConverter x:Key="LocFormat" />
  <c:LocUpperConverter x:Key="LocUpper" />
  <c:SRGBBrushConverter x:Key="SRGBBrush" />
  <c:ToolTitleConverter x:Key="ToolTitle" />
  <c:EqualsConverter x:Key="EqualsParam" />
  <c:UiTextConverter x:Key="UiText" />

  <!-- Text -->
  <Style x:Key="Glimmer.Text.Callout" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource Glimmer.Size.Callout}" />
  </Style>
  <Style x:Key="Glimmer.Text.Secondary" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource Glimmer.Size.Callout}" />
    <Setter Property="Foreground" Value="{DynamicResource Glimmer.MutedBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style x:Key="Glimmer.Text.Caption" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource Glimmer.Size.Caption}" />
    <Setter Property="Foreground" Value="{DynamicResource Glimmer.MutedBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style x:Key="Glimmer.Text.Headline" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource Glimmer.Size.Headline}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <!-- A label in small capitals, as the web app labels the options bar and the assistant panel. -->
  <Style x:Key="Glimmer.Text.SmallCaps" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource Glimmer.Size.Caption}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Glimmer.MutedBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Keyboard focus: a ring in the accent colour, 2 px outside the control. -->
  <Style x:Key="Glimmer.FocusVisual">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Rectangle Margin="-2" RadiusX="6" RadiusY="6" Stroke="{DynamicResource Glimmer.AccentBrush}" StrokeThickness="2" SnapsToDevicePixels="True" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Floating chrome surface (Swift panelSurface) -->
  <Style TargetType="c:PanelSurface">
    <Setter Property="Background" Value="{DynamicResource Glimmer.PanelSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Glimmer.EdgeBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource Glimmer.InkBrush}" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="c:PanelSurface">
          <Grid>
            <!-- The shadow sits on an empty sibling, so the content keeps ClearType text. -->
            <Border Margin="1" CornerRadius="{TemplateBinding CornerRadius}" Background="{DynamicResource Glimmer.PanelBrush}">
              <Border.Effect>
                <DropShadowEffect BlurRadius="26" ShadowDepth="6" Direction="270" Opacity="0.35" Color="Black" RenderingBias="Performance" />
              </Border.Effect>
            </Border>
            <Border CornerRadius="{TemplateBinding CornerRadius}" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter />
            </Border>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- AI, Tools, Layers, Export, Command Palette (Theme.swift ChromeChip) -->
  <Style TargetType="c:ChromeChip">
    <Setter Property="Foreground" Value="{DynamicResource Glimmer.MutedBrush}" />
    <Setter Property="Background" Value="{DynamicResource Glimmer.PanelSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Glimmer.EdgeBrush}" />
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="FontSize" Value="{StaticResource Glimmer.Size.Callout}" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource Glimmer.FocusVisual}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="c:ChromeChip">
          <Border x:Name="Chrome" CornerRadius="8" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="1" Padding="{TemplateBinding Padding}" MinHeight="{TemplateBinding MinHeight}" SnapsToDevicePixels="True">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <c:Icon Symbol="{TemplateBinding Symbol}" Size="13" VerticalAlignment="Center" />
              <TextBlock x:Name="Label" Margin="6,0,0,0" VerticalAlignment="Center"
                         Text="{Binding Title, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource Loc}}" />
            </StackPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="ShowsTitle" Value="False">
              <Setter TargetName="Label" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsMouseOver" Value="True" />
                <Condition Property="IsChecked" Value="False" />
              </MultiTrigger.Conditions>
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Glimmer.RaisedBrush}" />
              <Setter Property="Foreground" Value="{DynamicResource Glimmer.InkBrush}" />
            </MultiTrigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Glimmer.AccentTint35Brush}" />
              <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Glimmer.AccentBrush}" />
              <Setter Property="Foreground" Value="{DynamicResource Glimmer.InkBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Chrome" Property="Opacity" Value="0.85" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- A borderless icon button (SwiftUI .buttonStyle(.plain/.borderless) with an Image label). Give every one an
       AutomationProperties.Name and a ToolTip. -->
  <Style x:Key="Glimmer.IconButton" TargetType="ButtonBase">
    <Setter Property="Foreground" Value="{DynamicResource Glimmer.InkBrush}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="4" />
    <Setter Property="MinWidth" Value="24" />
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource Glimmer.FocusVisual}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ButtonBase">
          <Border x:Name="Chrome" CornerRadius="6" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Glimmer.RaisedBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Glimmer.EdgeBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Same, on the raised surface (the layer panel's arrows and fx). -->
  <Style x:Key="Glimmer.RaisedIconButton" TargetType="ButtonBase" BasedOn="{StaticResource Glimmer.IconButton}">
    <Setter Property="Background" Value="{DynamicResource Glimmer.RaisedBrush}" />
    <Setter Property="Width" Value="30" />
    <Setter Property="Height" Value="26" />
  </Style>

  <!-- Labelled buttons as in the web app's layer panel (LayersPanel.swift textButton). -->
  <Style x:Key="Glimmer.TextButton" TargetType="ButtonBase">
    <Setter Property="Foreground" Value="{DynamicResource Glimmer.InkBrush}" />
    <Setter Property="Background" Value="{DynamicResource Glimmer.RaisedBrush}" />
    <Setter Property="FontSize" Value="{StaticResource Glimmer.Size.Callout}" />
    <Setter Property="Padding" Value="9,0" />
    <Setter Property="Height" Value="26" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource Glimmer.FocusVisual}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ButtonBase">
          <Border x:Name="Chrome" CornerRadius="6" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Chrome" Property="Opacity" Value="0.88" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="Glimmer.TextButton.Prominent" TargetType="ButtonBase" BasedOn="{StaticResource Glimmer.TextButton}">
    <Setter Property="Background" Value="{DynamicResource Glimmer.AccentFillBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource Glimmer.OnAccentBrush}" />
  </Style>

  <!-- The compact Fluent variants (Glimmer.Compact.Button, .AccentButton, .ComboBox, .CheckBox, .TextBox, .Slider)
       are made in code by ThemeResources.Apply, after the Fluent dictionary is in place, so BasedOn finds the Fluent
       style for certain instead of depending on when WPF resolves a StaticResource. -->

  <!-- Plain text field without a box (TextField(...).textFieldStyle(.plain)): the omnibar, the palette. -->
  <Style x:Key="Glimmer.PlainTextBox" TargetType="TextBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource Glimmer.InkBrush}" />
    <Setter Property="CaretBrush" Value="{DynamicResource Glimmer.AccentBrush}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource Glimmer.AccentBrush}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Grid>
            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
            <TextBlock x:Name="Placeholder" Text="{TemplateBinding Tag}" Foreground="{DynamicResource Glimmer.MutedBrush}"
                       IsHitTestVisible="False" VerticalAlignment="Center" Margin="2,0,0,0" Visibility="Collapsed" TextTrimming="CharacterEllipsis" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="Text" Value="">
              <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Segmented picker (SwiftUI .pickerStyle(.segmented)): a ListBox whose selected item carries the accent fill. -->
  <Style x:Key="Glimmer.SegmentedItem" TargetType="ListBoxItem">
    <Setter Property="Foreground" Value="{DynamicResource Glimmer.InkBrush}" />
    <Setter Property="Padding" Value="10,3" />
    <Setter Property="FontSize" Value="{StaticResource Glimmer.Size.Callout}" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource Glimmer.FocusVisual}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="Chrome" CornerRadius="5" Background="Transparent" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Glimmer.EdgeBrush}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Glimmer.AccentFillBrush}" />
              <Setter Property="Foreground" Value="{DynamicResource Glimmer.OnAccentBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="Glimmer.Segmented" TargetType="ListBox">
    <Setter Property="ItemContainerStyle" Value="{StaticResource Glimmer.SegmentedItem}" />
    <Setter Property="SelectionMode" Value="Single" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
    <Setter Property="ItemsPanel">
      <Setter.Value>
        <ItemsPanelTemplate>
          <UniformGrid Rows="1" />
        </ItemsPanelTemplate>
      </Setter.Value>
    </Setter>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBox">
          <Border CornerRadius="7" Background="{DynamicResource Glimmer.RaisedBrush}" Padding="2" SnapsToDevicePixels="True">
            <ItemsPresenter />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- The tool rail: two columns of 32 × 30 buttons; the selected tool is tinted (DocumentView.swift ToolPalette). -->
  <Style x:Key="Glimmer.ToolRailItem" TargetType="ListBoxItem">
    <Setter Property="Foreground" Value="{DynamicResource Glimmer.InkBrush}" />
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="30" />
    <Setter Property="Margin" Value="1" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource Glimmer.FocusVisual}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="Chrome" CornerRadius="7" Background="Transparent" SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Glimmer.RaisedBrush}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Glimmer.AccentTint15Brush}" />
              <Setter Property="Foreground" Value="{DynamicResource Glimmer.AccentBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- A disclosure group (SwiftUI DisclosureGroup): chevron, header, content below. -->
  <Style x:Key="Glimmer.Disclosure" TargetType="Expander">
    <Setter Property="Foreground" Value="{DynamicResource Glimmer.InkBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Expander">
          <DockPanel>
            <ToggleButton x:Name="Header" DockPanel.Dock="Top" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                          Foreground="{TemplateBinding Foreground}" FocusVisualStyle="{StaticResource Glimmer.FocusVisual}"
                          AutomationProperties.Name="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}">
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                  <Border Background="Transparent" Padding="0,4">
                    <StackPanel Orientation="Horizontal">
                      <c:Icon x:Name="Chevron" Symbol="chevron.right" Size="10" Margin="0,0,6,0" RenderTransformOrigin="0.5,0.5">
                        <c:Icon.RenderTransform>
                          <RotateTransform x:Name="Turn" Angle="0" />
                        </c:Icon.RenderTransform>
                      </c:Icon>
                      <ContentPresenter VerticalAlignment="Center" />
                    </StackPanel>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True">
                      <Setter TargetName="Chevron" Property="RenderTransform">
                        <Setter.Value>
                          <RotateTransform Angle="90" />
                        </Setter.Value>
                      </Setter>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </ToggleButton.Template>
              <ContentPresenter ContentSource="Header" RecognizesAccessKey="False" />
            </ToggleButton>
            <ContentPresenter x:Name="Body" Margin="0,6,0,0" Visibility="Collapsed" />
          </DockPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsExpanded" Value="True">
              <Setter TargetName="Body" Property="Visibility" Value="Visible" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- A palette row as the web app shows it: category in small capitals, then the title, then the shortcut
       (CommandPalette.swift PaletteRowView). Used by the command palette and the omnibar. -->
  <Style x:Key="Glimmer.PaletteRowItem" TargetType="ListBoxItem">
    <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
    <Setter Property="Foreground" Value="{DynamicResource Glimmer.InkBrush}" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="Chrome" CornerRadius="7" Background="Transparent" Padding="{TemplateBinding Padding}">
            <ContentPresenter />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Glimmer.AccentTint15Brush}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Glimmer.AccentTint28Brush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <DataTemplate x:Key="Glimmer.PaletteRowTemplate" DataType="v:PaletteRow">
    <DockPanel>
      <TextBlock DockPanel.Dock="Right" Text="{Binding Shortcut}" FontFamily="{StaticResource Glimmer.MonoFont}" FontSize="{StaticResource Glimmer.Size.Caption}"
                 Foreground="{DynamicResource Glimmer.MutedBrush}" VerticalAlignment="Center" />
      <TextBlock x:Name="Category" DockPanel.Dock="Left" Width="92" Text="{Binding Category}" FontSize="{StaticResource Glimmer.Size.Caption2}" FontWeight="Medium"
                 Foreground="{DynamicResource Glimmer.MutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
      <c:Icon x:Name="Symbol" DockPanel.Dock="Left" Symbol="{Binding Symbol}" Size="13" Width="16" Margin="12,0" Foreground="{DynamicResource Glimmer.MutedBrush}" />
      <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
    </DockPanel>
    <DataTemplate.Triggers>
      <DataTrigger Binding="{Binding IsAsk}" Value="True">
        <Setter TargetName="Category" Property="Foreground" Value="{DynamicResource Glimmer.AccentBrush}" />
        <Setter TargetName="Symbol" Property="Foreground" Value="{DynamicResource Glimmer.AccentBrush}" />
      </DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>

  <!-- States (StatusLine.swift). The symbol carries the kind and its colour; the text stays in the label colour. -->
  <Style TargetType="c:StatusSymbol">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="c:StatusSymbol">
          <Grid>
            <c:Icon x:Name="Symbol" Size="13" Symbol="info.circle" Foreground="{DynamicResource Glimmer.Status.NoticeBrush}" />
            <c:Spinner x:Name="Working" Size="13" Visibility="Collapsed" Foreground="{DynamicResource Glimmer.MutedBrush}" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="Kind" Value="{x:Static core:StatusKind.Error}">
              <Setter TargetName="Symbol" Property="Symbol" Value="xmark.square.fill" />
              <Setter TargetName="Symbol" Property="Foreground" Value="{DynamicResource Glimmer.Status.ErrorBrush}" />
            </Trigger>
            <Trigger Property="Kind" Value="{x:Static core:StatusKind.Warning}">
              <Setter TargetName="Symbol" Property="Symbol" Value="exclamationmark.triangle.fill" />
              <Setter TargetName="Symbol" Property="Foreground" Value="{DynamicResource Glimmer.Status.WarningBrush}" />
            </Trigger>
            <Trigger Property="Kind" Value="{x:Static core:StatusKind.Success}">
              <Setter TargetName="Symbol" Property="Symbol" Value="checkmark.circle.fill" />
              <Setter TargetName="Symbol" Property="Foreground" Value="{DynamicResource Glimmer.Status.SuccessBrush}" />
            </Trigger>
            <Trigger Property="Kind" Value="{x:Static core:StatusKind.Working}">
              <Setter TargetName="Symbol" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="Working" Property="Visibility" Value="Visible" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="c:StatusLine">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="c:StatusLine">
          <StackPanel Orientation="Horizontal">
            <c:StatusSymbol Kind="{TemplateBinding Kind}" VerticalAlignment="Center" Margin="0,0,5,0" />
            <TextBlock Text="{TemplateBinding ShownText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
          </StackPanel>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- The title bar's top-level menu items (File, Edit, …): WPF Fluent's own TopLevelHeader template with smaller margins.
       Fluent puts 4 px and then 10 px around the text, which made each item about 50 px tall in the 40 px title bar and
       cut the words off at the bottom (seen on Windows 2026-11-20). MenuBuilder sets it as a local value on each top-level
       item: Fluent picks its role templates through StaticResource triggers, so a resource override would not take. -->
  <ControlTemplate x:Key="Glimmer.TitleBarMenuItemTemplate" TargetType="{x:Type MenuItem}">
    <Border x:Name="Border" Margin="1,4" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}" CornerRadius="6">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ContentPresenter x:Name="HeaderPresenter" Margin="10,4" VerticalAlignment="Center" ContentSource="Header" RecognizesAccessKey="True"
                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" TextElement.Foreground="{TemplateBinding Foreground}" />
        <Popup x:Name="PART_Popup" Grid.Row="1" AllowsTransparency="True" Focusable="False" HorizontalOffset="-12"
               IsOpen="{TemplateBinding IsSubmenuOpen}" Placement="Bottom" PlacementTarget="{Binding ElementName=Border}"
               PopupAnimation="None" VerticalOffset="1">
          <Grid>
            <Border x:Name="SubmenuBorder" Margin="12,0,12,18" Padding="0,3,0,3" Background="{DynamicResource FlyoutBackground}"
                    BorderBrush="{DynamicResource FlyoutBorderBrush}" BorderThickness="1" CornerRadius="8" SnapsToDevicePixels="True">
              <ScrollViewer CanContentScroll="True" Style="{DynamicResource MenuItemScrollViewerStyle}">
                <Grid>
                  <ItemsPresenter x:Name="ItemsPresenter" KeyboardNavigation.DirectionalNavigation="Cycle" KeyboardNavigation.TabNavigation="Cycle"
                                  Grid.IsSharedSizeScope="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                </Grid>
              </ScrollViewer>
              <Border.Effect>
                <DropShadowEffect BlurRadius="20" Direction="270" Opacity="0.25" ShadowDepth="6" />
              </Border.Effect>
            </Border>
          </Grid>
        </Popup>
      </Grid>
    </Border>
    <ControlTemplate.Triggers>
      <Trigger Property="IsHighlighted" Value="True">
        <Setter TargetName="Border" Property="Background" Value="{DynamicResource MenuBarItemBackgroundSelected}" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Foreground" Value="{DynamicResource Glimmer.MutedBrush}" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>
</ResourceDictionary>
