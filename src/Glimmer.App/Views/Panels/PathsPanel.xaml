<!-- Ported from App/PathsPanel.swift. The document's vector paths (pen tool output), with fill / stroke / selection
     actions. -->
<UserControl x:Class="Glimmer.App.Views.Panels.PathsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Glimmer.App.Controls"
             xmlns:l="clr-namespace:Glimmer.App.Localization"
             xmlns:core="clr-namespace:Glimmer.Core;assembly=Glimmer.Core">
  <DockPanel>
    <Button x:Name="ShapePath" DockPanel.Dock="Top" Style="{StaticResource Glimmer.IconButton}" HorizontalContentAlignment="Stretch" Padding="12,6"
            Click="OnShapePath" ToolTip="{l:Loc 'Edit the shape with the Pen tool'}" Visibility="Collapsed">
      <DockPanel>
        <c:Icon x:Name="ShapeEditing" DockPanel.Dock="Right" Symbol="pencil" Size="12" Foreground="{DynamicResource Glimmer.AccentBrush}" />
        <c:Icon Symbol="square.on.circle" Size="13" Foreground="{DynamicResource Glimmer.MutedBrush}" Margin="0,0,8,0" />
        <TextBlock x:Name="ShapePathName" />
      </DockPanel>
    </Button>
    <StackPanel DockPanel.Dock="Bottom">
      <Border Height="1" Background="{DynamicResource Glimmer.EdgeBrush}" />
      <DockPanel x:Name="Actions" Margin="8" LastChildFill="False">
        <Button Style="{StaticResource Glimmer.IconButton}" Click="OnFill" ToolTip="{l:Loc 'Fill the path with the foreground color on the active layer'}"
                AutomationProperties.Name="{l:Loc Fill}" Margin="0,0,12,0">
          <c:Icon Symbol="paintbrush.fill" Size="14" />
        </Button>
        <Button Style="{StaticResource Glimmer.IconButton}" Click="OnStroke" ToolTip="{l:Loc 'Stroke the path with the current brush'}"
                AutomationProperties.Name="{l:Loc Stroke}" Margin="0,0,12,0">
          <c:Icon Symbol="paintbrush.pointed" Size="14" />
        </Button>
        <Button Style="{StaticResource Glimmer.IconButton}" Click="OnSelection" ToolTip="{l:Loc 'Load the path as a selection'}"
                AutomationProperties.Name="{l:Loc Selection}" Margin="0,0,12,0">
          <c:Icon Symbol="lasso" Size="14" />
        </Button>
        <Button Style="{StaticResource Glimmer.IconButton}" Click="OnTypeOnPath" ToolTip="{l:Loc 'Add text that follows the path'}"
                AutomationProperties.Name="{l:Loc 'Type on Path'}">
          <c:Icon Symbol="character.cursor.ibeam" Size="14" />
        </Button>
        <Button DockPanel.Dock="Right" Style="{StaticResource Glimmer.IconButton}" Click="OnDelete" ToolTip="{l:Loc 'Delete the path'}"
                AutomationProperties.Name="{l:Loc Delete}">
          <c:Icon Symbol="trash" Size="14" />
        </Button>
      </DockPanel>
    </StackPanel>
    <Grid>
      <ListBox x:Name="List" Background="Transparent" BorderThickness="0" Padding="4" AutomationProperties.Name="{l:Loc Paths}"
               SelectionChanged="OnSelected" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.ItemContainerStyle>
          <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
            <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
          </Style>
        </ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate>
          <DataTemplate DataType="core:VectorPath">
            <DockPanel>
              <TextBlock DockPanel.Dock="Right" Text="{Binding Converter={x:Static c:PathsPanelConverters.PointCount}}" Style="{StaticResource Glimmer.Text.Caption}"
                         VerticalAlignment="Center" />
              <c:Icon Symbol="point.topleft.down.to.point.bottomright.curvepath" Size="13" Foreground="{DynamicResource Glimmer.MutedBrush}" Margin="0,0,8,0" />
              <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" MouseLeftButtonDown="OnNameClicked" />
            </DockPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="16" Visibility="Collapsed">
        <c:Icon Symbol="pencil.tip.crop.circle" Size="28" Foreground="{DynamicResource Glimmer.MutedBrush}" />
        <TextBlock Text="{l:Loc 'No Paths'}" Style="{StaticResource Glimmer.Text.Headline}" HorizontalAlignment="Center" Margin="0,8,0,4" />
        <TextBlock Text="{l:Loc 'Draw with the Pen tool (P) to create a path.'}" Style="{StaticResource Glimmer.Text.Secondary}" TextAlignment="Center" />
      </StackPanel>
    </Grid>
  </DockPanel>
</UserControl>
