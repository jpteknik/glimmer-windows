<!-- Ported from App/HistoryPanel.swift. Every undoable step since the document was opened. Clicking a step undoes or
     redoes to it; later steps stay redoable until the next edit. -->
<UserControl x:Class="Glimmer.App.Views.Panels.HistoryPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Glimmer.App.Controls"
             xmlns:l="clr-namespace:Glimmer.App.Localization"
             xmlns:p="clr-namespace:Glimmer.App.Views.Panels">
  <DockPanel>
    <TextBlock x:Name="Footnote" DockPanel.Dock="Bottom" Style="{StaticResource Glimmer.Text.Caption}" Margin="8" />
    <ListBox x:Name="Steps" Background="Transparent" BorderThickness="0" Padding="4" AutomationProperties.Name="{l:Loc History}"
             SelectionChanged="OnStepSelected" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <ListBox.ItemContainerStyle>
        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
          <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
          <Setter Property="AutomationProperties.HelpText" Value="{Binding Hint}" />
        </Style>
      </ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate>
        <DataTemplate DataType="p:HistoryRow">
          <StackPanel Orientation="Horizontal" Opacity="{Binding RowOpacity}">
            <c:Icon Symbol="{Binding Symbol}" Size="13" Margin="0,0,8,0" Foreground="{DynamicResource Glimmer.MutedBrush}" />
            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</UserControl>
