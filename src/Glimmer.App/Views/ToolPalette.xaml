<!-- Ported from App/DocumentView.swift (ToolPalette, ColorSwatches). Two columns of tools, then the foreground and
     background colour wells, swap and reset, and the swatches. -->
<UserControl x:Class="Glimmer.App.Views.ToolPalette"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Glimmer.App.Controls"
             xmlns:l="clr-namespace:Glimmer.App.Localization"
             xmlns:core="clr-namespace:Glimmer.Core;assembly=Glimmer.Core"
             AutomationProperties.Name="{l:Loc Tools}">
  <c:PanelSurface Padding="6" CornerRadius="12">
    <StackPanel>
      <ListBox x:Name="Tools" Background="Transparent" BorderThickness="0" Padding="0"
               SelectedItem="{Binding Session.Tool, Mode=TwoWay}" AutomationProperties.Name="{l:Loc Tools}"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
        <ListBox.ItemContainerStyle>
          <!-- Each tool is named for a screen reader, and says it is the selected one. -->
          <Style TargetType="ListBoxItem" BasedOn="{StaticResource Glimmer.ToolRailItem}">
            <Setter Property="AutomationProperties.Name" Value="{Binding Converter={StaticResource ToolTitle}}" />
          </Style>
        </ListBox.ItemContainerStyle>
        <ListBox.Template>
          <ControlTemplate TargetType="ListBox">
            <ItemsPresenter />
          </ControlTemplate>
        </ListBox.Template>
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Columns="2" />
          </ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.ItemTemplate>
          <DataTemplate DataType="core:ToolID">
            <c:Icon Symbol="{Binding Converter={x:Static c:ToolPaletteConverters.Symbol}}" Size="15"
                    ToolTip="{Binding Converter={x:Static c:ToolPaletteConverters.Help}}" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <!-- Foreground and background colours (X swaps, D resets). -->
      <Grid Width="66" Height="44" HorizontalAlignment="Center" Margin="0,6,0,0" ToolTip="{l:Loc 'Foreground and background colors (X swaps, D resets)'}">
        <c:ColorWell x:Name="BackgroundWell" Label="Background" SupportsOpacity="True" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="22,18,0,0"
                     Color="{Binding Session.Background, Mode=TwoWay}" Alpha="{Binding Session.BackgroundOpacity, Mode=TwoWay}" />
        <c:ColorWell x:Name="ForegroundWell" Label="Foreground" SupportsOpacity="True" HorizontalAlignment="Left" VerticalAlignment="Top"
                     Color="{Binding Session.Foreground, Mode=TwoWay}" Alpha="{Binding Session.ForegroundOpacity, Mode=TwoWay}" />
      </Grid>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
        <Button Style="{StaticResource Glimmer.IconButton}" Width="30" Height="20" Padding="0" Foreground="{DynamicResource Glimmer.MutedBrush}"
                Click="OnSwap" ToolTip="{l:Loc 'Swap foreground and background (X)'}" AutomationProperties.Name="{l:Loc 'Swap Colors'}">
          <c:Icon Symbol="arrow.left.arrow.right" Size="11" />
        </Button>
        <Button Style="{StaticResource Glimmer.IconButton}" Width="30" Height="20" Padding="0" Foreground="{DynamicResource Glimmer.MutedBrush}"
                Click="OnReset" ToolTip="{l:Loc 'Reset to black and white (D)'}" AutomationProperties.Name="{l:Loc 'Reset Colors'}">
          <c:Icon Symbol="circle.lefthalf.filled" Size="11" />
        </Button>
      </StackPanel>
      <ToggleButton x:Name="SwatchesButton" Style="{StaticResource Glimmer.IconButton}" Width="32" Height="22" Padding="0" HorizontalAlignment="Center"
                    Foreground="{DynamicResource Glimmer.MutedBrush}" ToolTip="{l:Loc Swatches}" AutomationProperties.Name="{l:Loc Swatches}">
        <c:Icon Symbol="swatchpalette" Size="13" />
      </ToggleButton>
      <Popup PlacementTarget="{Binding ElementName=SwatchesButton}" Placement="Right" HorizontalOffset="10" StaysOpen="False" AllowsTransparency="True"
             IsOpen="{Binding IsChecked, ElementName=SwatchesButton, Mode=TwoWay}">
        <c:PanelSurface Padding="14" CornerRadius="10">
          <ContentControl x:Name="SwatchesHost" Focusable="False" />
        </c:PanelSurface>
      </Popup>
    </StackPanel>
  </c:PanelSurface>
</UserControl>
