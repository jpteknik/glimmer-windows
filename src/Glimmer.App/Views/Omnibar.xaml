<!-- Ported from App/CommandPalette.swift (Omnibar). Type a command or describe an edit, right on the canvas. Enter runs
     the best match (or asks the assistant when the text reads like a request), Ctrl+Enter always asks the assistant. -->
<UserControl x:Class="Glimmer.App.Views.Omnibar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Glimmer.App.Controls"
             xmlns:l="clr-namespace:Glimmer.App.Localization"
             Width="720">
  <StackPanel>
    <!-- As in the web app: things to generate on an empty canvas, otherwise things to do to the image. -->
    <c:PanelSurface x:Name="Suggestions" CornerRadius="12" Height="38" Padding="12,0" Margin="0,0,0,8" Visibility="Collapsed">
      <StackPanel x:Name="Chips" Orientation="Horizontal" VerticalAlignment="Center" TextElement.FontSize="{StaticResource Glimmer.Size.Caption}" />
    </c:PanelSurface>
    <c:PanelSurface x:Name="RowsSurface" CornerRadius="12" Padding="6" Margin="0,0,0,8" Visibility="Collapsed">
      <ListBox x:Name="Rows" Background="Transparent" BorderThickness="0" Focusable="False"
               ItemContainerStyle="{StaticResource Glimmer.PaletteRowItem}" ItemTemplate="{StaticResource Glimmer.PaletteRowTemplate}"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled" PreviewMouseLeftButtonUp="OnRowClicked" />
    </c:PanelSurface>
    <c:PanelSurface CornerRadius="12" Height="52" Padding="18,0">
      <DockPanel>
        <c:Icon DockPanel.Dock="Left" Symbol="sparkles" Size="16" Foreground="{DynamicResource Glimmer.AccentBrush}" Margin="0,0,12,0" VerticalAlignment="Center" />
        <TextBlock DockPanel.Dock="Right" Text="{l:Loc '↩ run · ⌘↩ ask AI · ⌘K palette'}" Style="{StaticResource Glimmer.Text.Caption}"
                   TextWrapping="NoWrap" VerticalAlignment="Center" Margin="12,0,0,0" />
        <TextBox x:Name="Query" Style="{StaticResource Glimmer.PlainTextBox}" FontSize="{StaticResource Glimmer.Size.Title3}"
                 Tag="{l:Loc 'Describe an edit, or type a command…'}" AutomationProperties.Name="{l:Loc 'Describe an edit, or type a command'}"
                 TextChanged="OnQueryChanged" PreviewKeyDown="OnQueryKey" GotKeyboardFocus="OnFocusChanged" LostKeyboardFocus="OnFocusChanged" />
      </DockPanel>
    </c:PanelSurface>
  </StackPanel>
</UserControl>
