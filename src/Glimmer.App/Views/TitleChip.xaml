<!-- Ported from App/DocumentView.swift (TitleChip). Logo, document name, size and zoom, top left, plus whatever is in
     progress. A group named "Document status" whose parts are each read. -->
<UserControl x:Class="Glimmer.App.Views.TitleChip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Glimmer.App.Controls"
             xmlns:l="clr-namespace:Glimmer.App.Localization"
             xmlns:core="clr-namespace:Glimmer.Core;assembly=Glimmer.Core"
             AutomationProperties.Name="{l:Loc 'Document status'}" Focusable="False">
  <c:PanelSurface Padding="10,0" CornerRadius="8" Height="28">
    <StackPanel Orientation="Horizontal" TextElement.FontSize="{DynamicResource Glimmer.Size.Callout}">
      <StackPanel.Resources>
        <Style TargetType="TextBlock">
          <Setter Property="VerticalAlignment" Value="Center" />
          <Setter Property="Margin" Value="0,0,8,0" />
          <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
      </StackPanel.Resources>
      <c:Icon Symbol="sparkle" Size="13" Foreground="{DynamicResource Glimmer.AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
      <TextBlock Text="{Binding DocumentTitle}" FontWeight="Medium" />
      <TextBlock Text="{Binding SizeText}" Foreground="{DynamicResource Glimmer.MutedBrush}" />
      <TextBlock Text="{Binding ZoomText}" Foreground="{DynamicResource Glimmer.MutedBrush}" Typography.NumeralAlignment="Tabular" />
      <StackPanel Orientation="Horizontal" Visibility="{Binding Session.PaintsMask, Converter={StaticResource BoolToVisibility}}" Margin="0,0,8,0">
        <c:Icon Symbol="rectangle.dashed" Size="12" Foreground="{DynamicResource Glimmer.MutedBrush}" Margin="0,0,4,0" VerticalAlignment="Center" />
        <TextBlock Text="{l:Loc 'Editing mask'}" Foreground="{DynamicResource Glimmer.MutedBrush}" Margin="0" />
      </StackPanel>
      <!-- Whom it is for is never cut short; the hint after it gives way first in a narrow window. -->
      <StackPanel Orientation="Horizontal" Visibility="{Binding LinkedForText, Converter={StaticResource NullToVisibility}}"
                  TextElement.Foreground="{DynamicResource Glimmer.AccentBrush}" Margin="0,0,8,0">
        <c:Icon Symbol="link" Size="12" Margin="0,0,4,0" VerticalAlignment="Center" />
        <TextBlock Text="{Binding LinkedForText}" TextTrimming="None" Margin="0,0,4,0" />
        <TextBlock Text="{l:Loc '– ⌘S saves back'}" Margin="0" Visibility="{Binding ShowsSaveBackHint, Converter={StaticResource BoolToVisibility}}" />
      </StackPanel>
      <c:StatusLine Kind="{x:Static core:StatusKind.Error}" TextKey="Latest steps not kept: disk full" Margin="0,0,8,0"
                    ToolTip="{Binding Session.JournalRoomTrouble}" Visibility="{Binding Session.JournalRoomTrouble, Converter={StaticResource NullToVisibility}}" />
      <c:StatusLine Kind="{x:Static core:StatusKind.Warning}" TextKey="Kept from last time: not saved back yet" Margin="0,0,8,0"
                    ToolTip="{l:Loc 'You left this file with edits that were not saved back. They were kept and are here again. They are not in the file until you save them back. Undo starts from here.'}"
                    Visibility="{Binding ShowsKeptFromLastTime, Converter={StaticResource BoolToVisibility}}" />
      <c:StatusLine Kind="{x:Static core:StatusKind.Warning}" TextKey="Brought back: not saved back yet" Margin="0,0,8,0"
                    ToolTip="{l:Loc 'Glimmer stopped while this file had edits that were not saved back. They were kept and are here again. They are not in the file until you save them back. Undo starts from here.'}"
                    Visibility="{Binding ShowsBroughtBack, Converter={StaticResource BoolToVisibility}}" />
      <StackPanel Orientation="Horizontal" Margin="0,0,8,0" ToolTip="{Binding Session.BrokenLink.Reason}"
                  Visibility="{Binding Session.BrokenLink, Converter={StaticResource NullToVisibility}}">
        <c:StatusLine Kind="{x:Static core:StatusKind.Error}" TextKey="Can't save back" Margin="0,0,4,0" />
        <TextBlock Text="{Binding BrokenLinkTo}" Margin="0" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" Visibility="{Binding Session.IsExporting, Converter={StaticResource BoolToVisibility}}" Margin="0,0,8,0">
        <c:Spinner Size="12" Margin="0,0,5,0" VerticalAlignment="Center" Foreground="{DynamicResource Glimmer.MutedBrush}" />
        <TextBlock Text="{l:Loc 'Exporting…'}" Foreground="{DynamicResource Glimmer.MutedBrush}" Margin="0" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" Visibility="{Binding RunningJob, Converter={StaticResource NullToVisibility}}">
        <c:Spinner Size="12" Margin="0,0,5,0" VerticalAlignment="Center" Foreground="{DynamicResource Glimmer.MutedBrush}" />
        <TextBlock Text="{Binding RunningJob}" Foreground="{DynamicResource Glimmer.MutedBrush}" Margin="0" />
      </StackPanel>
    </StackPanel>
  </c:PanelSurface>
</UserControl>
